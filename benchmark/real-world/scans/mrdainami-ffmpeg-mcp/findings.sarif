          ]
        },
        {
          "ruleId": "hardcoded-credential-default",
          "level": "warning",
          "message": {
            "text": "Credential falls back to a baked-in default — console.error(`[dainami-ffmpeg-mcp] FFMPEG_MCP_WORKDIR raw: ${process.env.FFMPEG_MCP_WORKDIR ?? \"(unset)\"}`); console…"
          },
          "properties": {
            "confidence": "likely"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
