{
  "name": "mcp-audit",
  "version": "0.1.0",
  "description": "Security linter for MCP servers: prompt injection, over-broad scopes, unpinned deps, exfiltration shapes.",
  "type": "module",
  "bin": {
    "mcp-audit": "bin/mcp-audit.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "audit:demo": "node bin/mcp-audit.js test/fixtures/bad-server",
    "audit:self": "node bin/mcp-audit.js . --exclude test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "linter",
    "audit",
    "supply-chain",
    "llm",
    "agent",
    "prompt-injection"
  ],
  "license": "MIT",
  "author": "cheappicklecodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheappicklecodes/mcp-audit.git"
  }
}
