{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mcp-audit",
          "version": "0.5.3",
          "informationUri": "https://github.com/cheappicklecodes/mcp-audit",
          "rules": [
            {
              "id": "shell-injection",
              "name": "Caller-controlled string reaches a shell",
              "shortDescription": {
                "text": "Caller-controlled string reaches a shell"
              },
              "fullDescription": {
                "text": "The shell parses the string, so everything in it is syntax: `;`, `&&`, `$()` and backticks all run. When the caller writes that string, the caller is writing code, and the tool description is the only boundary."
              },
              "help": {
                "text": "Either validate against an allowlist that matches the whole command and fails closed, or move to `execFile` with an argv array so nothing is parsed."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "path-traversal",
              "name": "Joins caller-supplied paths without a containment check",
              "shortDescription": {
                "text": "Joins caller-supplied paths without a containment check"
              },
              "fullDescription": {
                "text": "`path.join(ROOT, args.path)` looks confined but is not: `../../etc/passwd` walks straight out of ROOT, and an absolute segment discards the prefix entirely. The model writes that string, and so does anything else that can call the tool."
              },
              "help": {
                "text": "Resolve, then compare with a separator: `const p = path.resolve(ROOT, input); if (!p.startsWith(ROOT + path.sep)) throw`. On Windows use `path.relative` and reject a leading `..`."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "shell-exec",
              "name": "Executes shell commands",
              "shortDescription": {
                "text": "Executes shell commands"
              },
              "fullDescription": {
                "text": "Shell access turns a data source into an actor. Once the model can pass a string to a shell, argument injection becomes command injection and the tool description becomes the trust boundary."
              },
              "help": {
                "text": "Use an allowlist, avoid `shell: true`, and quote interpolated values."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "write-capability",
              "name": "Can write or mutate files and state",
              "shortDescription": {
                "text": "Can write or mutate files and state"
              },
              "fullDescription": {
                "text": "Read-plus-write is where mistakes become damage. Note whether writes are confined and whether they are reversible."
              },
              "help": {
                "text": "Confine write roots, and prefer explicit overwrite semantics over silent replace."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "unpinned-dependency",
              "name": "Dependency ranges that can float",
              "shortDescription": {
                "text": "Dependency ranges that can float"
              },
              "fullDescription": {
                "text": "A caret or star range means today’s install and tomorrow’s install can be different code. For a component that holds credentials and runs commands, that is unearned trust."
              },
              "help": {
                "text": "Pin exact versions, or at minimum commit a lockfile and install with `npm ci`."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "install-script",
              "name": "Package runs code at install time",
              "shortDescription": {
                "text": "Package runs code at install time"
              },
              "fullDescription": {
                "text": "preinstall/install/postinstall executes before you have run anything, with your user permissions. This is the standard vector for a compromised dependency."
              },
              "help": {
                "text": "Read the script. Pin the version and check it has no network access."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "transport",
              "name": "Uses stdio transport",
              "shortDescription": {
                "text": "Uses stdio transport"
              },
              "fullDescription": {
                "text": "Local stdio servers inherit your user account. There is no sandbox between the server and your files."
              },
              "help": {
                "text": "Prefer stdio for local work and HTTP with auth for remote."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "capability-mismatch",
              "name": "Capability declaration does not match what the server serves",
              "shortDescription": {
                "text": "Capability declaration does not match what the server serves"
              },
              "fullDescription": {
                "text": "The capabilities block is the contract the host negotiates with. Declaring `tools: {}` and then answering `tools/list` means the client never agreed to tools, so list-change notifications go nowhere and some hosts keep a stale catalog. The reverse — advertising tools with no `tools/call` handler — gives the model a catalog it cannot invoke."
              },
              "help": {
                "text": "Declare what the server really serves: `capabilities: { tools: { listChanged: true } }`, and implement every tool listed."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
