                }
              }
            }
          ]
        },
        {
          "ruleId": "shell-exec",
          "level": "error",
          "message": {
            "text": "Executes shell commands — allowedDistro} sh -c \"${joined}\"` : `wsl sh -c \"${joined}\"`; const { stdout } = await"
          },
          "properties": {
            "confidence": "likely",
            "detail": "process spawn"
          },
          "locations": [
