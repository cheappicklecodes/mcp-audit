{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mcp-audit",
          "version": "0.5.3",
          "informationUri": "https://github.com/cheappicklecodes/mcp-audit",
          "rules": [
            {
              "id": "shell-exec",
              "name": "Executes shell commands",
              "shortDescription": {
                "text": "Executes shell commands"
              },
              "fullDescription": {
                "text": "Shell access turns a data source into an actor. Once the model can pass a string to a shell, argument injection becomes command injection and the tool description becomes the trust boundary."
              },
              "help": {
                "text": "Use an allowlist, avoid `shell: true`, and quote interpolated values."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "unpinned-dependency",
              "name": "Dependency ranges that can float",
              "shortDescription": {
                "text": "Dependency ranges that can float"
              },
              "fullDescription": {
                "text": "A caret or star range means today’s install and tomorrow’s install can be different code. For a component that holds credentials and runs commands, that is unearned trust."
              },
              "help": {
                "text": "Pin exact versions, or at minimum commit a lockfile and install with `npm ci`."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "shell-exec",
          "level": "error",
          "message": {
            "text": "Executes shell commands — \"\"\"Execute a shell command\"\"\" return subprocess.check_output(command, shell=True).decode"
          },
          "properties": {
            "confidence": "likely",
            "detail": "process spawn"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.py"
                },
                "region": {
                  "startLine": 38
                }
              }
            }
          ]
        },
        {
          "ruleId": "unpinned-dependency",
          "level": "warning",
          "message": {
            "text": "Dependency ranges that can float — langchain-mcp-adapters"
          },
          "properties": {
            "confidence": "likely",
            "detail": "no exact pin"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "unpinned-dependency",
          "level": "warning",
          "message": {
            "text": "Dependency ranges that can float — httpx"
          },
          "properties": {
            "confidence": "likely",
            "detail": "no exact pin"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        },
        {
          "ruleId": "unpinned-dependency",
          "level": "warning",
          "message": {
            "text": "Dependency ranges that can float — python-dotenv"
          },
          "properties": {
            "confidence": "likely",
            "detail": "no exact pin"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
