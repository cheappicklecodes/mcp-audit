{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mcp-audit",
          "version": "0.5.3",
          "informationUri": "https://github.com/cheappicklecodes/mcp-audit",
          "rules": [
            {
              "id": "broad-fs-access",
              "name": "Server can reach the whole filesystem or home directory",
              "shortDescription": {
                "text": "Server can reach the whole filesystem or home directory"
              },
              "fullDescription": {
                "text": "A server scoped to a project can be compromised for the cost of the project. One scoped to `~` or `/` can read every repo, key and note on the machine — including files it never advertised."
              },
              "help": {
                "text": "Scope roots to the directories the server actually serves."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "reads-credentials",
              "name": "Reads credential or key material",
              "shortDescription": {
                "text": "Reads credential or key material"
              },
              "fullDescription": {
                "text": "Reading your private keys and cloud config means a bug in this server is a bug in everything you are logged into. Most servers need one secret and touch ten."
              },
              "help": {
                "text": "Pass the single secret the server needs instead of letting it crawl config directories."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "shell-exec",
              "name": "Executes shell commands",
              "shortDescription": {
                "text": "Executes shell commands"
              },
              "fullDescription": {
                "text": "Shell access turns a data source into an actor. Once the model can pass a string to a shell, argument injection becomes command injection and the tool description becomes the trust boundary."
              },
              "help": {
                "text": "Use an allowlist, avoid `shell: true`, and quote interpolated values."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "remote-no-auth",
              "name": "HTTP server bound without obvious auth",
              "shortDescription": {
                "text": "HTTP server bound without obvious auth"
              },
              "fullDescription": {
                "text": "An MCP server speaking HTTP with tools attached and no token check is an unauthenticated API into your filesystem or accounts for anything on the network."
              },
              "help": {
                "text": "Require a bearer token; bind to localhost when the server is local-only."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "object-merge",
              "name": "Merges caller-supplied objects",
              "shortDescription": {
                "text": "Merges caller-supplied objects"
              },
              "fullDescription": {
                "text": "Naive `Object.assign`/spread merging lets `__proto__` in tool arguments reach the prototype chain."
              },
              "help": {
                "text": "Filter `__proto__`, or use a merge that blocks it."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "outbound-network",
              "name": "Makes outbound network calls",
              "shortDescription": {
                "text": "Makes outbound network calls"
              },
              "fullDescription": {
                "text": "An MCP server with data access and an outbound socket can ship that data anywhere. Worth knowing which endpoints, and whether a local-first tool is quietly phoning home."
              },
              "help": {
                "text": "Confirm the endpoint. For privacy-sensitive servers prefer opt-out telemetry or none."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "unpinned-dependency",
              "name": "Dependency ranges that can float",
              "shortDescription": {
                "text": "Dependency ranges that can float"
              },
              "fullDescription": {
                "text": "A caret or star range means today’s install and tomorrow’s install can be different code. For a component that holds credentials and runs commands, that is unearned trust."
              },
              "help": {
                "text": "Pin exact versions, or at minimum commit a lockfile and install with `npm ci`."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "write-capability",
              "name": "Can write or mutate files and state",
              "shortDescription": {
                "text": "Can write or mutate files and state"
              },
              "fullDescription": {
                "text": "Read-plus-write is where mistakes become damage. Note whether writes are confined and whether they are reversible."
              },
              "help": {
                "text": "Confine write roots, and prefer explicit overwrite semantics over silent replace."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "public-bind",
              "name": "Listens on all interfaces",
              "shortDescription": {
                "text": "Listens on all interfaces"
              },
              "fullDescription": {
                "text": "`0.0.0.0` exposes the port to the LAN and any container network, not just this machine."
              },
              "help": {
                "text": "Bind `127.0.0.1` unless remote access is the point."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "telemetry",
              "name": "Analytics or telemetry SDK present",
              "shortDescription": {
                "text": "Analytics or telemetry SDK present"
              },
              "fullDescription": {
                "text": "Telemetry decides what leaves the machine before you have asked the tool anything."
              },
              "help": {
                "text": "Look for a documented off switch and confirm the endpoint."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "sensitive-fallback",
              "name": "Falls back to a sensitive config file",
              "shortDescription": {
                "text": "Falls back to a sensitive config file"
              },
              "fullDescription": {
                "text": "Configs like `.npmrc` hold publish tokens; silently reading them widens the blast radius beyond MCP."
              },
              "help": {
                "text": "Document which config file is read and consider a dedicated credential."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "transport",
              "name": "Uses stdio transport",
              "shortDescription": {
                "text": "Uses stdio transport"
              },
              "fullDescription": {
                "text": "Local stdio servers inherit your user account. There is no sandbox between the server and your files."
              },
              "help": {
                "text": "Prefer stdio for local work and HTTP with auth for remote."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
